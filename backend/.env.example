# ===================================
# Environment Configuration
# ===================================
# Options: production, staging, development, local
ENVIRONMENT=development

# ===================================
# Database Configuration
# ===================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# For Docker Compose: use 'db' (the service name)
# For local development without Docker: use 'localhost'
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_SYNC_PREFIX=postgresql://
POSTGRES_ASYNC_PREFIX=postgresql+asyncpg://
CREATE_TABLES_ON_STARTUP=true

# Hosted / serverless Postgres (Neon, RDS, Cloud SQL, ...): DATABASE_URL overrides
# every POSTGRES_* value above. Mind the asyncpg spelling — the driver prefix is
# postgresql+asyncpg:// and TLS is ssl=require, NOT libpq's sslmode=require.
# DATABASE_URL=postgresql+asyncpg://user:password@host.example.com/dbname?ssl=require

# Connection pool. POSTGRES_POOL_PRE_PING tests a connection before handing it out,
# so connections dropped by an idle timeout or a suspended serverless compute are
# replaced instead of failing a request. POSTGRES_POOL_RECYCLE discards connections
# older than N seconds (-1 disables); set it below your provider's idle timeout.
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=0
POSTGRES_POOL_PRE_PING=true
POSTGRES_POOL_RECYCLE=-1

# ===================================
# Cache Configuration
# ===================================
CACHE_ENABLED=true
# Options: memcached, redis
CACHE_BACKEND=redis
DEFAULT_CACHE_EXPIRATION=3600

# Client-side cache settings
CLIENT_CACHE_ENABLED=true
CLIENT_CACHE_MAX_AGE=60

# Cache Memcached settings (when using CACHE_BACKEND=memcached)
CACHE_MEMCACHED_HOST=localhost
CACHE_MEMCACHED_PORT=11211
CACHE_MEMCACHED_POOL_SIZE=10
CACHE_MEMCACHED_CONNECT_TIMEOUT=5

# Cache Redis settings (when using CACHE_BACKEND=redis)
# For Docker Compose: use 'redis' (the service name)
# For local development without Docker: use 'localhost'
CACHE_REDIS_HOST=redis
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
CACHE_REDIS_PASSWORD=
CACHE_REDIS_CONNECT_TIMEOUT=5
CACHE_REDIS_POOL_SIZE=10

# ===================================
# Taskiq Configuration
# ===================================
# Background task processing. Enrichment waterfalls call out to several external
# APIs per contact, so bulk runs belong on a worker rather than in the request.
TASKIQ_ENABLED=true
# Broker type: 'redis' or 'rabbitmq'
TASKIQ_BROKER_TYPE=redis

# Redis broker settings (used when TASKIQ_BROKER_TYPE=redis)
# For Docker Compose: use 'redis' (the service name)
# For local development without Docker: use 'localhost'
TASKIQ_REDIS_HOST=redis
TASKIQ_REDIS_PORT=6379
TASKIQ_REDIS_DB=3
TASKIQ_REDIS_PASSWORD=

# RabbitMQ broker settings (used when TASKIQ_BROKER_TYPE=rabbitmq)
TASKIQ_RABBITMQ_HOST=localhost
TASKIQ_RABBITMQ_PORT=5672
TASKIQ_RABBITMQ_USER=guest
TASKIQ_RABBITMQ_PASSWORD=guest
TASKIQ_RABBITMQ_VHOST=/

# Taskiq worker settings
TASKIQ_WORKER_CONCURRENCY=2
TASKIQ_MAX_TASKS_PER_WORKER=1000

# ===================================
# Web Server Configuration
# ===================================
# CORS settings
CORS_ENABLED=true
# Comma-separated list of allowed origins
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Compression settings
GZIP_ENABLED=true
GZIP_MINIMUM_SIZE=1000

# API documentation settings
ENABLE_DOCS_IN_PRODUCTION=false
OPENAPI_PREFIX=

# Security response headers (HSTS, X-Frame-Options, etc.)
SECURITY_HEADERS_ENABLED=true

# ===================================
# Application Settings
# ===================================
DEBUG=false
APP_NAME=GTM Waterfall Enrichment
APP_DESCRIPTION=Self-hosted lead enrichment waterfall + CRM sync engine
VERSION=0.1.0
CONTACT_NAME=Support
CONTACT_EMAIL=support@example.com
LICENSE_NAME=MIT

# API settings (optional overrides)
# API_PREFIX=/api
# DOCS_URL=/docs
# REDOC_URL=/redoc

# ===================================
# Enrichment Provider Credentials
# ===================================
# Leaving a key blank puts that provider's client in mock mode (fake data instead
# of a live API call), so the waterfall is testable end-to-end without any keys.
HUNTER_API_KEY=
APOLLO_API_KEY=

# ===================================
# CRM Sync Credentials
# ===================================
# Same mock-mode behavior: blank means HubSpotClient returns a fake external id
# instead of calling the live API. Create a private app in HubSpot's free tier
# and grant it the crm.objects.contacts.write scope to get a real token.
HUBSPOT_PRIVATE_APP_TOKEN=

# ===================================
# Deployment Checklist
# ===================================
# This API ships with NO authentication — it is designed to run self-hosted behind
# your own network boundary. Before exposing it anywhere:
# 1. Keep it on a private network / VPN, or put an authenticating proxy in front.
# 2. Set unique database passwords (avoid defaults like 'postgres').
# 3. Set CACHE_REDIS_PASSWORD and TASKIQ_REDIS_PASSWORD.
# 4. Use separate Redis databases per service: Cache=0, Taskiq=3.
# 5. Restrict CORS_ORIGINS to specific domains (avoid *).
# 6. Set ENVIRONMENT=production.
# 7. Configure RabbitMQ with strong credentials (avoid guest/guest).
# 8. Provider API keys belong in .env only — never commit them.
